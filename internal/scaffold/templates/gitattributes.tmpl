# Normalise text, and keep the engine's binary formats out of the diff.
* text=auto eol=lf

*.c        text
*.h        text
*.hpp      text
*.cpp      text
*.ext      text
*.rvmat    text
*.bisurf   text
*.nu       text
*.py       text
*.md       text
*.json     text
*.xml      text
*.yml      text
*.yaml     text
*.toml     text
*.cfg      text
*.layout   text
*.txt      text
*.csv      text
*.svg      text

*.p3d          binary
*.paa          binary
*.pbo          binary
*.edds         binary
*.dds          binary
*.rtm          binary
*.wrp          binary
*.bikey        binary
*.biprivatekey binary
*.bisign       binary
*.fbx          binary
*.ogg          binary
*.wss          binary
*.png          binary
*.jpg          binary
*.tga          binary
*.psd          binary
*.zip          binary
